    "qa:prod:oauth:expand:apply": "node scripts/qa/apply-oauth-production-rollout.mjs --stage expand --apply",
    "qa:prod:oauth:app-postflight": "node scripts/qa/apply-oauth-production-rollout.mjs --stage app-postflight",
