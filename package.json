  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@portone/browser-sdk": "^0.1.9",
    "@portone/server-sdk": "^0.19.0",
    "@sentry/nextjs": "^10.57.0",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.107.0",
    "@types/matter-js": "^0.20.2",
    "matter-js": "^0.20.0",
    "next": "16.2.12",
    "pixi.js": "^8.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "react-test-renderer": "^19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "$sharp"
  }
