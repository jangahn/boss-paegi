    "dev": "node scripts/qa/run-node22-command.mjs node node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/qa/assert-node-major.mjs",
    "build": "node scripts/qa/assert-node-major.mjs && next build",
