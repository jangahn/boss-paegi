    "start": "node scripts/qa/assert-node-major.mjs && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/qa/run-node-tests.mjs",
    "test:db": "bash scripts/qa/run-local-pgtap.sh",
    "qa:db:apply": "bash scripts/qa/apply-local-migrations.sh",
    "qa:db:permanent-surface": "bash scripts/qa/test-permanent-surface-contract.sh",
