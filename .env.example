# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 운영 계정 user.id — 생성권 무제한(크레딧 차감 면제). 미설정 시 무제한 계정 없음.
# Kakao/Google OAuth provider 키는 앱이 아니라 Supabase Auth config(Management API)에 저장.
OPS_USER_ID=

# fal.ai (server-only)
FAL_KEY=
# fal.ai ADMIN scope key — 잔액 조회용 (hard cap: $2 미만이면 생성 중단).
# 미설정 시 잔액 체크 없이 동작. fal dashboard 에서 ADMIN scope 로 발급.
FAL_ADMIN_KEY=

# Public site URL (OG/share links and PortOne/FAL webhook/redirect URLs)
# ⚠️ Vercel prod 에 실제 HTTPS 공개 도메인 필수. localhost/사설 IP면 FAL 제출이 차단됨.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First-party UTM/referrer acquisition analytics. Exact "1" opt-in only.
# Keep unset until the published privacy notice names the fields and retention.
NEXT_PUBLIC_ANALYTICS_ENABLED=

# 포트원(PortOne V2) 결제 — 미설정 시 결제 비활성(503).
# DB-first rollout 중 reviewer 우회까지 닫는 서버 route gate. 현재 빌드는
# 분리된 청약철회 제한 적극 확인·불변 증거를 구현했지만, exact "1"은
# expand/contract·provider backfill/drain·smoke 완료 뒤에만 설정한다.
# 미설정/다른 값은 fail-closed 503.
PAYMENT_CHECKOUT_ENABLED=
# 서버 전용(절대 NEXT_PUBLIC_ 노출 금지):
#   PORTONE_V2_API_SECRET: 콘솔 [연동 관리]>[식별코드·API Keys]>[V2 API] (단건 조회·취소)
#   PORTONE_WEBHOOK_SECRET(_TEST): 콘솔 [결제알림(Webhook) 관리] 발급(whsec_~) —
#     실연동/테스트 환경이 **동시 운영**되므로 각각의 시크릿을 병존(검증은 두 키 순차 시도).
PORTONE_V2_API_SECRET=
# PORTONE_API_BASE_URL은 운영에 설정하지 않는다. 서버는 운영에서 exact
# https://api.portone.io만 허용하며, test/development의 loopback stub만 예외다.
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_SECRET_TEST=
# 클라 공개 식별자(포트원 설계상 공개 안전값 — 승인·취소 권한 없음):
#   STORE_ID: store-~ / CHANNEL_KEY_*: 콘솔 채널관리의 채널별 채널키.
#   무접미사 = 실연동 채널(일반 유저), _TEST = 테스트 채널(심사·테스트 계정 전용 — 계정 기반
#   스위칭은 lib/config/domains/growth.ts payModeFor). 미설정 수단/모드는 UI·체크아웃에서 숨김·차단.
#   CARD=KPN 신용카드 일반결제 · TOSSPAY/KAKAOPAY=간편결제 직연동.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_CARD=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_TOSSPAY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_CARD_TEST=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_TOSSPAY_TEST=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY_TEST=

# cron 보호 시크릿 — cron-job.org 가 x-cron-secret 헤더로 전달. 미설정 시 해당 cron 비활성(503).
# 보호 대상(전부 동일 시크릿): POST /api/ops/{reconcile,gen-recover,telemetry-maintain,
#   content-maintain,analytics-maintain,integrity-scan,credit-expire,privacy-maintain}.
# content-maintain은 만료 미디어와 Storage/Auth/reviewer durable job을 drain한다.
# 충분히 긴 랜덤 문자열.
CRON_SECRET=

# Sentry (에러/경고 알림). 미설정 시 Sentry 전부 no-op (앱 정상).
# DSN 만 있으면 런타임 캡처 동작. AUTH_TOKEN/ORG/PROJECT 는 빌드 시 소스맵 업로드용(선택).
NEXT_PUBLIC_SENTRY_DSN=
# Session Replay는 기본 비활성. production에서 exact literal "1"일 때만
# Replay integration과 sampling(오류 100%·일반 10%)을 활성화한다.
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# (선택) 클라 이벤트 environment 구분 — Vercel 에 NEXT_PUBLIC_VERCEL_ENV=production 등 추가 시 사용.
# NEXT_PUBLIC_VERCEL_ENV=
# Exact opt-in for paid generation cost paths. 현재 빌드는 fal 얼굴/PII 서면
# 허용·exact 국외이전/보존·private ACL/owner-token 계약이 미확정이라
# compile-time fence가 닫혀 있어 "1"이어도 열리지 않는다.
GENERATION_COST_PATH_ENABLED=0
